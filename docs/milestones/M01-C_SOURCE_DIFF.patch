+TOOLS = {
+    "gdcae_capabilities": {},
+    "gdcae_list_runs": {"limit": 2},
+    "gdcae_get_run": {"run_id": RUN},
+    "gdcae_get_receipt": {"key": "original-key"},
+    "gdcae_list_events": {"limit": 2},
