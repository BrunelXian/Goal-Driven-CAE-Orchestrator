+                        lambda key: native.stop(owner['owner_id'], key))
+    require(stop['receipt']['state'] == 'STOP_COMMITTED' and stop['receipt']['owner_id'] == owner['owner_id']
+            and stop['receipt']['start_id'] == owner['start_id'], 'STOP_UNKNOWN')
